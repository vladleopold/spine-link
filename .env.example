# Server-side GitHub upload target for Vercel /api/github-upload.
GITHUB_OWNER=vladleopold
GITHUB_REPO=spine
GITHUB_BRANCH=main
GITHUB_BASE_PATH=library

# Required server-side secret. Use a fine-grained token for repo vladleopold/spine
# with Repository permissions → Contents: Read and write.
GITHUB_TOKEN=github_pat_...

# Google OAuth client ID, shared by the server verifier and browser sign-in.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Separate server-to-server animation agent write key (at least 32 unpredictable bytes).
# Configure as an encrypted/sensitive Vercel environment variable. Never put it in VITE_*.
SPINE_LINK_AGENT_API_KEY=replace-with-a-secret-of-at-least-32-random-bytes
